# Check the health of the RBD mirroring for the given pools and exit with
# a non-zero exit code if any pool is not healthy, making it usable both
# interactively and from monitoring systems.
#
#   Usage: rbd-mirror-health <pool> [<pool>...]

set -o errexit
set -o nounset
set -o pipefail

if [ "$#" -eq 0 ]; then
    echo "usage: $(basename "$0") <pool> [<pool>...]" >&2
    exit 2
fi

exit_code=0

for pool in "$@"; do
    if ! status="$(cephadm shell -- rbd mirror pool status --format json "${pool}" 2>/dev/null)"; then
        echo "${pool}: unable to retrieve mirroring status" >&2
        exit_code=1
        continue
    fi

    if ! python3 -c '
import json
import sys

pool = sys.argv[1]
summary = json.loads(sys.stdin.read()).get("summary", {})

health = summary.get("health", "UNKNOWN")
daemon_health = summary.get("daemon_health", "UNKNOWN")
image_health = summary.get("image_health", "UNKNOWN")
states = summary.get("states", {})

print(
    f"{pool}: health={health} daemon={daemon_health} "
    f"images={image_health} states={states}"
)
sys.exit(0 if health == "OK" else 1)
' "${pool}" <<< "${status}"; then
        exit_code=1
    fi
done

exit "${exit_code}"
